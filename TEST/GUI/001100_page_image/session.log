OOF.Image.Undo(image='serendipity.png:serendipity.png')
OOF.Image.Modify.AddNoise(image='serendipity.png:serendipity.png', sigma=0.1, seed=automatic)
OOF.Microstructure.New(name='microstructure', width=1, height=1, width_in_pixels=10, height_in_pixels=10)
OOF.Image.Rename(image='serendipity.png:serendipity.png', name='renamed')
OOF.File.Save.Image(filename='image.ppm', overwrite=False, image='serendipity.png:renamed')
