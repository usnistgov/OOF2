OOF.Microstructure.Create_From_ImageFile(filename='examples/serendipity.png', microstructure_name='serendipity.png', height=automatic, width=automatic)
OOF.Windows.Graphics.New()
OOF.Graphics_1.Layer.New(category='Image', what='serendipity.png:serendipity.png', how=BitmapDisplayMethod())
OOF.Image.Modify.Gray(image='serendipity.png:serendipity.png')
OOF.Image.Undo(image='serendipity.png:serendipity.png')
