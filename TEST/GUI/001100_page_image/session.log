OOF.Image.Modify.Dim(image='serendipity.png:serendipity.png', factor=0.9)
OOF.Image.Modify.Contrast(image='serendipity.png:serendipity.png', radius=5)
OOF.Image.Modify.Edge(image='serendipity.png:serendipity.png', mode='RGB')
OOF.Image.Undo(image='serendipity.png:serendipity.png')
OOF.Image.Modify.Equalize(image='serendipity.png:serendipity.png')
OOF.Image.Undo(image='serendipity.png:serendipity.png')
OOF.Image.Modify.MedianFilter(image='serendipity.png:serendipity.png', radius=2)
OOF.Image.Modify.Negate(image='serendipity.png:serendipity.png')
OOF.Image.Modify.Normalize(image='serendipity.png:serendipity.png')
OOF.Image.Modify.Denoise(image='serendipity.png:serendipity.png', method=TotalVariation(weight=0.1,eps=0.0002,max_iterations=200))
