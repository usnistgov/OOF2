OOF.Image.Modify.Flip(image='serendipity.png:serendipity.png', axis='y')
OOF.Image.Undo(image='serendipity.png:serendipity.png')
OOF.Image.Undo(image='serendipity.png:serendipity.png')
OOF.Image.Copy(image='serendipity.png:serendipity.png', microstructure='serendipity.png', name='serendipity.png<2>')
OOF.Image.Copy(image='serendipity.png:serendipity.png<2>', microstructure='serendipity.png', name='copy')
OOF.Image.Delete(image='serendipity.png:serendipity.png<2>')
OOF.Image.AutoGroup(image='serendipity.png:serendipity.png', name_template='%c')
