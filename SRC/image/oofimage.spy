#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

# For debugging.

def printnpcolor(npimage, i, j):
    vals = npimage[i,j]
    debug.fmsg(f"npimage[{i}, {j}] = {vals} {list(x/255 for x in vals)}")

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def getNumpyData(filename):
    # Utility to do the basic reading of a file, but not to massage
    # the image. It calls the appropriate readers for the various file
    # types.  Used here and in image_test.
    #
    # Use special handlers for .npy, .npz, and tiff, and matplotlib
    # for the rest.  Scikit-image loads many types incorrectly.
    extension = os.path.splitext(filename)[1]
    if extension == ".npy":
        return numpy.load(filename)
    if extension == ".npz":
        imagedict = numpy.load(filename)
        if len(imagedict) != 1:
            raise ooferror.PyErrUserError(
                f"Image file {filename} must contain exactly one image.")
        (imgname,) = imagedict # unpack keys into a tuple
        return imagedict[imgname]
    if extension in (".tif", ".tiff"):
        return tifffile.imread(filename)
    return matplotlib.pyplot.imread(filename)
        

def readNumpyImage(filename, **kwargs):
    # 'height' and 'width' keywords are optional.  If neither is
    # given, the height and width are the image size in pixels.  If
    # just one is given, the other is determined from the aspect
    # ratio.  If both are given, the pixels may not be square.

    npimage = getNumpyData(filename)

    # Find out if the image is gray or not, and delete alpha channels.
    if len(npimage.shape) == 2:
        # Gray scale with no alpha channel
        isgray = True
    elif npimage.shape[2] == 2:
        # Gray scale with an alpha channel.  Remove the alpha channel.
        npimage = npimage[:,:,0]
        isgray = True
    elif npimage.shape[2] == 3:
        # Image is RGB already.
        isgray = False
    elif npimage.shape[2] == 4:
        # RGB with an alpha channel
        npimage = npimage[:,:,0:3] # just remove the alpha channel
        isgray = False
    else:
        raise ooferror.PyErrUserError(
            f"Image file {filename} is not in a recognized format.")

    # See if the image is grayscale but stored as RGB.
    if len(npimage.shape)==3 and npimage.shape[2] == 3:
        if ((npimage[:,:,0]==npimage[:,:,1]).all() and
            (npimage[:,:,1]==npimage[:,:,2]).all()):
            npimage = npimage[:,:,0]
            isgray = True
            
    # The image read from the file probably has 8 bit channels.  For
    # internal calculations, we want more than that.  We probably
    # don't need 64 bits, but since all other calculations use doubles
    # it's convenient to use them here too.  If this is a problem for
    # storage or speed, change from float64 to float32 here, and
    # change the data type used by CColor too.
    #
    # It might also be possible to have separate subclasses of
    # OOFImage for different numpy data types, but that might really
    # complicate things elsewhere.
    npimage = skimage.util.img_as_float64(npimage)
    
    # Flip along the y axis (so that y coord increases upwards)
    npimage = numpy.flip(npimage, 0)
    # Make a copy so that the flipped data is actually stored in the
    # numpy array.
    npimage = npimage.copy()

    # Colons in image names are disallowed, because we use them as
    # separators in the labeltree.
    basename = os.path.basename(filename).replace(':','.')
    
    image = OOFImage(basename, npimage, isgray)
    
    # Set physical size of image
    pixelsize = image.sizeInPixels()    # iPoint
    given_height = 'height' in kwargs
    given_width = 'width' in kwargs
    if not (given_height or given_width):
        width = float(pixelsize.x)
        height = float(pixelsize.y)
    elif given_width and given_height:
        width = float(kwargs['width'])
        height = float(kwargs['height'])
    else:
        aspect = float(pixelsize.x)/pixelsize.y
        if given_width:
            width = float(kwargs['width'])
            height = width/aspect
        elif given_height:
            height = float(kwargs['height'])
            width = height*aspect
    image.setSize(primitives.Point(width, height))

    return image

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def OOFImage_clone(self, name):
    return self.cclone(name, self.npImage().copy(), self.isGray())

OOFImage.clone = OOFImage_clone
    
#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

# For testing, it's important that the images are saved the same way
# on all platforms.  OOFImage.makeLittleEndian converts a big-endian
# image to little-endian if necessary, and returns a bool indicating
# if it did.  OOFImage.makeBigEndian can be called to convert it back.

def _makeLittleEndian(self):
    npimage = self.npImage()
    if npimage.dtype != numpy.dtype("<d"):
        npimage.byteswap(inplace=True)
        return True
    return False

def _makeBigEndian(self):
    self.npImage().byteswap(inplace=True)

OOFImage.makeLittleEndian = _makeLittleEndian
OOFImage.makeBigEndian = _makeBigEndian


#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def _getTimeStamp_optional_args(self, *args):
    return self._getTimeStamp()
OOFImage.getTimeStamp = _getTimeStamp_optional_args

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def getImage(imagename):
    ## returns the actual image
    ## imagename = microstructurename:image_name OR
    ## imagename = [microstructurename, image_name]
    return imagecontext.imageContexts[imagename].getObject()

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def pushModification(imagename, image):
    imagecontext.imageContexts[imagename].pushModification(image)

def undoModification(imagename):
    imagecontext.imageContexts[imagename].undoModification()

def redoModification(imagename):
    imagecontext.imageContexts[imagename].redoModification()

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def undoable(imagename):
    return imagecontext.imageContexts[imagename].undoable()

def redoable(imagename):
    return imagecontext.imageContexts[imagename].redoable()

