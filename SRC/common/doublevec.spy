def _doublevec__iadd__(self, other):
    if isinstance(other, DoubleVec):
        self.c_iadd(other)
        return self
    return NotImplemented

DoubleVec.__iadd__ = _doublevec__iadd__

def _doublevec__isub__(self, other):
    if isinstance(other, DoubleVec):
        self.c_isub(other)
        return self
    return NotImplemented

DoubleVec.__isub__ = _doublevec__isub__

def _doublevec__imul__(self, x):
    if isinstance(x, (float, int)):
        self.c_imul(x)
        return self
    return NotImplemented

DoubleVec.__imul__ = _doublevec__imul__

def _doublevec__idiv__(self, x):
    if isinstance(x, (float, int)):
        self.c_idiv(x)
        return self
    return NotImplemented

DoubleVec.__idiv__ = _doublevec__idiv__
