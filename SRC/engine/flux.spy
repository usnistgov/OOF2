from ooflib.common import debug
from ooflib.common import utils
from ooflib.SWIG.engine import ooferror
from ooflib.SWIG.engine import planarity
from ooflib.SWIG.common import switchboard

def _Flux___hash__(self):
    return self.objectid()

Flux.__hash__ = _Flux___hash__

# Fluxes are sometimes stored in an OrderedSet and need to have __lt__
# defined.

def _Flux___lt__(self, other):
    try:
        return self.objectid() < other.objectid()
    except:
        return NotImplemented

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

# C++ keeps a list of base class Flux pointers, one for each defined
# Flux.  Python keeps a dict of derived class objects in _AllFluxes,
# keyed by name.  The main OOF2 python namespace also stores each Flux
# by name in its dict.  That dict would be unnecessary if we were
# willing to run OOFeval(fluxname) in getFlux().  OOFeval should be
# only used where absolutely necessary.

class _AllFluxes:
    def __init__(self):
        self.fluxDict = {} 
    def __getitem__(self, indx):
        if isinstance(indx, int):
            if not 0 <= indx < len(self.fluxDict):
                raise ooferror.PyErrPyProgrammingError(
                    f"Bad flux index: {indx}")
            return getFluxByIndex(indx)
        elif isinstance(indx, (str, bytes)):
            try:
                return self.fluxDict[indx]
            except KeyError as exc:
                raise ooferror.PyErrPyProgrammingError(f"Bad flux name: {indx}")
    def __len__(self):
        return len(self.fluxDict)
    def addFlux(self, flux):
        if flux.name() in self.fluxDict:
            raise ooferror.PyErrPyProgrammingError(
                f"Flux {flux.name()} is multiply defined")
        self.fluxDict[flux.name()] = flux
        utils.OOFdefine(flux.name(), flux)
        switchboard.notify("new flux")
    
allFluxes = _AllFluxes()

def getFlux(which):
    return allFluxes[which]

utils.OOFdefine('getFlux', getFlux)

# finishConstruction is called after the swigged constructors for all
# of the Flux subclasses.

def finishConstruction(flx):
    allFluxes.addFlux(flx)

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

def _fluxiter(comps):
    beginp = comps.begin()
    endp = comps.end()
    while beginp != endp:
        yield beginp.current()
        beginp.increment()

def _Flux_components(self, plan=planarity.ALL_INDICES):
    return _fluxiter(self.c_components(plan))

Flux.components = _Flux_components

def _Flux_divergenceComponents(self):
    return _fluxiter(self.c_divergenceComponents())

Flux.divergenceComponents = _Flux_divergenceComponents

def _Flux_outOfPlaneComponents(self):
    return _fluxiter(self.c_outOfPlaneComponents())

Flux.outOfPlaneComponents = _Flux_outOfPlaneComponents
