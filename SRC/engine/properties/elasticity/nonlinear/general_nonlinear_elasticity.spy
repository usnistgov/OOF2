from ooflib.common.IO import parameter
from ooflib.engine import problem
from ooflib.engine import propertyregistration

## General Nonlinear Elasticity test property

reg = propertyregistration.PropertyRegistration(
    name='Mechanical:Elasticity:TestGeneralNonlinearElasticity',
    subclass=TestGeneralNonlinearElasticity,
    ordering=202,
    params=[parameter.IntParameter('testno', 1, tip="Test number for the general nonlinear elasticity property.")],
    propertyType="Elasticity",
    secret=True,
    tip="Test property for general nonlinear elasticity."
    )

reg.fluxInfo( fluxes=[problem.Stress], fields=[problem.Displacement],
              time_derivs=[0], nonlinear=True )
