from ooflib.common import debug

## TODO: FIX THIS.  We shouldn't have to import smallsystem here.  But
## if we don't, then the SmallSystem that gets passed to flux_matrix
## in PyHeatConductivity, for example, doesn't have the methods that
## are added to it by smallsystem.py (the swig-generated file).  The
## simplest fix would be to move those methods to C++ and swig them.
##
## Comment out the import line and run 'oof2-test pyproperty_test' to
## see the problem.
##
##   File "/Users/langer/lib/python3.14/site-packages/oof2/ooflib/engine/properties/heatconductivity/pyheatconductivity.py", line 56, in flux_matrix
##    fluxdata.add_stiffness_matrix_element(
##    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
## AttributeError: 'swig_runtime_data5.SwigPyObject' object has no attribute 'add_stiffness_matrix_element'

from ooflib.SWIG.engine import smallsystem

#=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=##=--=#

# The C++ base classes for Python Property objects need access to
# self, since they store a reference to the Python object.  Redefine
# the SWIG-generated __init__ so that self is passed as the "referent"
# argument to the C++ constructor.

def _PyFluxProperty___init__(self, *args, **kwargs):
    realargs = list(args)
    realargs.insert(2, self)
    _pypropertywrapper.PyFluxProperty_swiginit(
        self, _pypropertywrapper.new_PyFluxProperty(*realargs, **kwargs))

PyFluxProperty.__init__ = _PyFluxProperty___init__

def _PyEqnProperty___init__(self, *args, **kwargs):
    realargs = list(args)
    realargs.insert(2, self)
    _pypropertywrapper.PyEqnProperty_swiginit(
        self, _pypropertywrapper.new_PyEqnProperty(*realargs, **kwargs))

PyEqnProperty.__init__ = _PyEqnProperty___init__

def _PyAuxProperty___init__(self, *args, **kwargs):
    realargs = list(args)
    realargs.insert(2, self)
    _pypropertywrapper.PyAuxProperty_swiginit(
        self, _pypropertywrapper.new_PyAuxProperty(*realargs, **kwargs))

PyAuxProperty.__init__ = _PyAuxProperty___init__

